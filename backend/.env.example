PORT=5001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ecn_fin_tracker
DB_USER=postgres
DB_PASSWORD=postgres

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Campaign Configuration
CAMPAIGN_START_DATE=2025-02-10
CAMPAIGN_DURATION_DAYS=120

# Backup
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30

# Bank Integration (sandbox/mock — replace when going live)
BANK_API_BASE_URL=https://api.yourbank.com/v1
BANK_API_KEY=REPLACE_WITH_REAL_KEY
BANK_API_SECRET=REPLACE_WITH_REAL_SECRET
BANK_INSTITUTION_ID=ECN_INSTITUTION_001
BANK_SAVINGS_PRODUCT_ID=SAVINGS_120DAY
BANK_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
BANK_CURRENCY=NGN
BANK_ENVIRONMENT=sandbox
